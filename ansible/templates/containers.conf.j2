# Podman engine defaults for this deployment. Deployed to
# /etc/containers/containers.conf on the target (the only deployment
# file that does not live under /opt/forgejo).
#
# userns: job containers created by the Actions runner over the
# Docker-compatible API get a user namespace, which is what makes
# nested buildah RUN work without privileged containers. The size must
# be explicit: plain "auto" sizes the namespace to the image's largest
# /etc/passwd uid (1024 for the job images), which leaves out system
# users like _apt (65534) and breaks apt inside jobs. `podman kube
# play` ignores this setting, so the app and runner pods keep host uid
# semantics and the uid 1000 bind mounts work unchanged.
#
# dns: the host resolver is the systemd-resolved stub at 127.0.0.53,
# which is unreachable from a container network namespace. Point
# containers at a LAN resolver directly. The reproduce procedure replaces
# the placeholder below with the operator-supplied resolver address.
[containers]
userns="auto:size=65536"
dns=["{{ lan_resolver }}"]
