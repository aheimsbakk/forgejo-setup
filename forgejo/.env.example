# Copy to /opt/forgejo/.env on the target. LAN_IP is the address the
# machine serves Forgejo on; ports bind to it, so it must be a local
# address of the host. The kube YAML carries the same address literally;
# this file is the record `gen-cert.sh` reads. The value below is a
# placeholder from the RFC 5737 documentation range; set your real LAN
# address.
LAN_IP=192.0.2.40
